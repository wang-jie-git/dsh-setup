{
  "name": "@wang-jie-git/dsh-memory-ai",
  "version": "1.1.11",
  "type": "module",
  "description": "AI-memory 深度集成 —— 基于 One Memory 源码的 DSH 语义记忆插件",
  "main": "build/index.js",
  "exports": {
    ".": "./build/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@wang-jie-git/memory-orchestrator": "^1.1.1",
    "@xenova/transformers": "^2.17.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "memory",
    "semantic",
    "ai-memory",
    "ai-memory",
    "vector-search"
  ],
  "license": "MIT",
  "files": [
    "build/",
    "src/client.js",
    "cordis.patch.yml"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs"
  }
}